{
  "apiVersion": 1,
  "submit": {
    "method": "POST",
    "url": "{{baseUrl}}/v1/videos/generations",
    "timeoutMs": 90000,
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer {{apiKey}}"
    },
    "body": {
      "model": "{{model}}",
      "prompt": "{{fields.prompt}}",
      "resolution": "{{fields.resolution}}",
      "duration": "{{number fields.duration}}",
      "image": {
        "$switch": "{{facet.modelFamily}}",
        "$cases": {
          "grok-imagine-video-1.5": {
            "image_url": "{{media.referenceImage.0}}"
          }
        }
      }
    },
    "extract": {
      "taskId": ["request_id", "id", "data.request_id", "data.id"]
    },
    "error": {
      "from": ["error.message", "error", "message", "detail"]
    }
  },
  "poll": {
    "method": "GET",
    "url": "{{baseUrl}}/v1/videos/{{upstreamTaskId}}",
    "timeoutMs": 15000,
    "intervalMs": 5000,
    "maxTotalMs": 1800000,
    "headers": {
      "Authorization": "Bearer {{apiKey}}"
    },
    "status": {
      "from": ["status", "state"],
      "completed": ["completed", "succeeded", "success", "done"],
      "failed": ["failed", "fail", "error"],
      "queued": ["queued", "pending", "queueing", "preparing", "waiting"],
      "processing": ["processing", "in_progress", "running", "generating"]
    },
    "progress": {
      "from": ["progress"],
      "scale": "0-100"
    },
    "result": {
      "assets": [
        {
          "kind": "video",
          "mime": "video/mp4",
          "url": [
            "video_url",
            "video.url",
            "url",
            "output.url",
            "output.video_url",
            "result.url",
            "result.video_url",
            "data.0.url",
            "data.0.video_url"
          ],
          "posterUrl": ["thumbnail_url", "cover_url", "cover_image_url"],
          "durationSec": ["duration", "duration_seconds"]
        }
      ]
    },
    "error": {
      "from": ["error.message", "error", "message", "detail"]
    },
    "fatalHttpStatus": [400, 401, 403]
  }
}
